{
	"name": "@maxstack/web",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"description": "L2 — the admin web app: Sprout-driven CRUD UI + JSON-RPC MCP transport, on React Router framework mode",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"demo:seed": "node --experimental-transform-types scripts/seed-demo.ts",
		"test:e2e": "playwright test",
		"check:seo": "node --experimental-transform-types scripts/check-seo.ts"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@maxstack/core": "workspace:*",
		"@maxstack/features": "workspace:*",
		"@maxstack/spec-derive": "workspace:*",
		"@maxstack/mcp": "workspace:*",
		"@maxstack/spec": "workspace:*",
		"@maxstack/ui": "workspace:*",
		"@react-router/node": "^8.3.0",
		"@react-router/serve": "^8.3.0",
		"better-auth": "^1.6.25",
		"drizzle-orm": "1.0.0-rc.4",
		"isbot": "^5.2.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"ts-morph": "^28.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@maxstack/examples": "workspace:*",
		"@playwright/test": "^1.62.0",
		"@react-router/dev": "^8.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4.3.3",
		"vite": "^8.1.5"
	}
}
