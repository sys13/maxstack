{
	"name": "@maxstack/features",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"description": "L5 — feature bundles (auth, billing, content, email, ...): runtime + artifacts + prerequisites + DI",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./api-keys": {
			"types": "./src/api-keys/index.ts",
			"default": "./src/api-keys/index.ts"
