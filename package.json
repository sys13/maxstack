{
	"name": "maxstack-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@11.7.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --parallel",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test --concurrency=50%",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:write-paths": "node scripts/check-write-paths.mjs",
		"check:owned-writes": "node scripts/check-owned-writes.mjs",
		"check:guarded-statements": "node scripts/check-guarded-statements.mjs",
		"check:client-safe-imports": "node scripts/check-client-safe-imports.mjs",
		"check:test-integrity": "node scripts/check-test-integrity.mjs",
		"docs:reference": "pnpm --filter maxstack run docs:reference",
		"check:docs-reference": "pnpm --filter maxstack run docs:reference:check",
		"release": "node --experimental-transform-types apps/maxstack/scripts/cut-release.ts",
		"validate": "node scripts/validate.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.1",
		"jsdom": "^29.1.1",
		"turbo": "^2.10.6",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
